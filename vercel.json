    {
    "version": 2,
    "functions": {
        "api/index.php": { "runtime": "vercel-php@0.7.4" }
    },
    "routes": [
        { "src": "/api/(.*)", "dest": "/api/index.php" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_URL": "https://project-skripsi-ten.vercel.app",
        "APP_CONFIG_CACHE": "",
        "APP_EVENTS_CACHE": "",
        "APP_PACKAGES_CACHE": "",
        "APP_SERVICES_CACHE": "",
        "VIEW_COMPILED_PATH": "/tmp",
        "CACHE_DRIVER": "array",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "cookie"
    }
    }
